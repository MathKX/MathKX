        "visuals": [
          {
            "type": "make-ten",
            "attributes": {
              "a": "8",
              "b": "5"
            }
          }
        ]
      }
    },
    {
      "name": "table-cells",
      "markdown": "| Pair | Sum |\n| --- | --- |\n| 1 and 9 | $1 + 9 = 10$ |\n| 4 and 6 | $4 + 6 = 10$ |\n",
      "expected": {
        "expressions": [
          "1 + 9 = 10",
          "4 + 6 = 10"
        ],
        "visuals": []
      }
    },
    {
      "name": "unicode-minus",
      "markdown": "Here $9 − 4 = 5$ and $9 - 4 = 5$.\n",
      "expected": {
        "expressions": [
