<mxfile host="MathKX" modified="2026-10-22T00:00:00.000Z" agent="make-diagrams.mjs" version="24.7.17" type="device"><diagram id="mathkx-data-model" name="MathKX data model"><mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1110" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="gContent" value="&lt;b&gt;Content in Git, validated by tools/validate-content.mjs in CI&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px&quot;&gt;Language-neutral IDs; nb and en ship together; identity = id + version&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#aeb7c4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=13;fontStyle=1;fontColor=#2d3748;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="1250" height="790" as="geometry"/></mxCell><mxCell id="skill" value="&lt;b&gt;Skill · content/skills/&lt;id&gt;.json&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;id: numbers.addition-within-20&lt;br&gt;schemaVersion: 0.1&lt;br&gt;prerequisites: skill id[]&lt;br&gt;ladder?: [{ definition, version,&lt;br&gt;  description { nb, en } }]&lt;br&gt;&lt;i&gt;names and curricula live elsewhere&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4f7cb0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="220" height="150" as="geometry"/></mxCell><mxCell id="lesson" value="&lt;b&gt;Lesson · lessons/&lt;id&gt;/lesson.json&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;id (= folder), version: int ≥ 1&lt;br&gt;status: draft | pilot | released&lt;br&gt;skills: skill id[] (≥ 1)&lt;br&gt;prerequisites?, relatedSkills?: skill id[]&lt;br&gt;relatedLessons?: lesson id[]&lt;br&gt;practice: [{ definition, version }]&lt;br&gt;visuals?: component type[]&lt;br&gt;translations: { nb: nb.md, en: en.md }&lt;br&gt;&lt;i&gt;check (prototype field) is rejected&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4f7cb0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="320" y="140" width="260" height="220" as="geometry"/></mxCell><mxCell id="translation" value="&lt;b&gt;LessonTranslation · nb.md, en.md&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;front matter: title, objective&lt;br&gt;headings with {#anchor} (same set)&lt;br&gt;body: CommonMark + GFM tables&lt;br&gt;images with alt text → assets/&lt;br&gt;math $…$ in the pilot grammar&lt;br&gt;&lt;i&gt;prose and order are free per language&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4f7cb0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="640" y="140" width="240" height="170" as="geometry"/></mxCell><mxCell id="directive" value="&lt;b&gt;Directive · :::name{…} … :::&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;visual { type, a, b | start }&lt;br&gt;example { id, title* }&lt;br&gt;practice { definition, version }&lt;br&gt;identity: name + id | definition@version&lt;br&gt;  | type + attributes&lt;br&gt;&lt;i&gt;* localized attribute&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4f7cb0;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="940" y="140" width="250" height="170" as="geometry"/></mxCell><mxCell id="def" value="&lt;b&gt;ExerciseDefinition · 0.1-pilot&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;id, version, skill&lt;br&gt;source: generated | fixed&lt;br&gt;validator: { name, version }&lt;br&gt;generator?: { name, version,&lt;br&gt;  parameters { operand, sum: min..max } }&lt;br&gt;instance?: { prompt { a, b },&lt;br&gt;  validation { answer } }&lt;br&gt;representations: { help[], explanation[] }&lt;br&g