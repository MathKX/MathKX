<mxfile host="MathKX" modified="2026-10-22T00:00:00.000Z" agent="make-diagrams.mjs" version="24.7.17" type="device"><diagram id="mathkx-architecture" name="MathKX architecture"><mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="gDelivery" value="&lt;b&gt;Contribution and delivery (GitHub: MathKX/MathKX)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px&quot;&gt;Monorepo (ADR 0001). Code and docs MIT, content CC BY-SA 4.0 (ADR 0010). Every change is a reviewed pull request.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#aeb7c4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=13;fontStyle=1;fontColor=#2d3748;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1400" height="170" as="geometry"/></mxCell><mxCell id="contrib" value="&lt;b&gt;Contributors&lt;/b&gt;&lt;br&gt;educators, developers,&lt;br&gt;review agents (Claude, Codex,&lt;br&gt;Gemini) per review-process.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbe9e9;strokeColor=#b5504c;fontSize=11;fontColor=#2d3748;" vertex="1" parent="1"><mxGeometry x="60" y="115" width="200" height="90" as="geometry"/></mxCell><mxCell id="pr" value="&lt;b&gt;Pull request to main&lt;/b&gt;&lt;br&gt;spec-driven work: Spec Kit&lt;br&gt;constitution v1.0.0, specs/NNN&lt;br&gt;(specify → plan → tasks → implement)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1fb;strokeColor=#4f7cb0;fontSize=11;fontColor=#2d3748;" vertex="1" parent="1"><mxGeometry x="320" y="115" width="220" height="90" as="geometry"/></mxCell><mxCell id="ci" value="&lt;b&gt;GitHub Actions: validate-content.yml&lt;/b&gt;&lt;br&gt;npm run validate · npm test&lt;br&gt;schemas, references, cycles,&lt;br&gt;lesson pairing (spec 001)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf3e2;strokeColor=#b9802a;fontSize=11;fontColor=#2d3748;" vertex="1" parent="1"><mxGeometry x="600" y="115" width="260" height="90" as="geometry"/></mxCell><mxCell id="review" value="&lt;b&gt;Review and decisions&lt;/b&gt;&lt;br&gt;docs/reviews rounds 01–04,&lt;br&gt;decision log DL-001…040,&lt;br&gt;ADRs in docs/architecture/decisions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf3e2;strokeColor=#b9802a;fontSize=11;fontColor=#2d3748;" vertex="1" parent="1"><mxGeometry x="920" y="115" width="240" height="90" as="geometry"/></mxCell><mxCell id="deploy" value="&lt;b&gt;Deployment pipeline (planned)&lt;/b&gt;&lt;br&gt;build .NET API and web app,&lt;br&gt;package content/, deploy to&lt;br&gt;App Service; IaC undecided" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7f8a9c;fontSize=11;fontColor=#2d3748;dashed=1;" vertex="1" parent="1"><mxGeometry x="1220" y="115" width="200" height="90" as="geometry"/></mxCell><mxCell id="gRepo" value="&lt;b&gt;Repository layout&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px&quot;&gt;content/ schemas/ tools/ docs/ Prototype/ exist today; src/ arrives with spec 002&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#aeb7c4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=13;fontStyle=1;fontColor=#2d3748;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="700" height="420" as="geometry"/></mxCell><mxCell id="content" value="&lt;b&gt;content/&lt;/b&gt;&lt;br&gt;skills (graph, ladder)&lt;br&gt;exercises (definitions 0.1, 0.1-pilot)&lt;br&gt;lessons (lesson.json, nb.md, en.md,&lt;br&gt;assets/)&lt;br&gt;registry (generators, validators,&lt;br&gt;representations, components, codes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1fb;strokeColor=#4f7cb0;fontSize=11;fontColor=#2d3748;" vertex="1" parent="1"><mxGeometry x="60" y="320" width="200" height="130" as="geometry"/></mxCell><mxCell id="schemas" value="&lt;b&gt;schemas/&lt;/b&gt;&lt;br&gt;JSON Schema 2020-12&lt;br&gt;skill · exercise (0.1) · lesson ·&lt;br&gt;exercise-definition.pilot · registry&lt;br&gt;schema and docs change together" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1fb;strokeColor=#4f7cb0;fontSize=11;fontColor=#2d3748;" vertex="1" parent="1"><mxGeometry x="290" y="320" width="200" height="130" as="geometry"/></mxCell><mxCell id="tools" value="&lt;b&gt;tools/&lt;/b&gt;&lt;br&gt;validate-content.mjs + lib/&lt;br&gt;Node 22 ESM, Ajv strict, remark,&lt;br&gt;notation grammar, pairing checks&lt;br&gt;regression tests (node --test)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf3e2;strokeColor=#b9802a;fontSize=11;fontColor=#2d3748;" vertex="1" parent="1"><mxGeometry x="520" y="320" width="200" height="130" as="geometry"/></mxCell><mxCell id="docs" value="&lt;b&gt;docs/&lt;/b&gt;&lt;br&gt;vision, product principles,&lt;br&gt;learning model, design,&lt;br&gt;architecture, ADRs, reviews,&lt;br&gt;specs/ (Spec Kit)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1fb;strokeColor=#4f7cb0;fontSize=11;fontColor=#2d3748;" vertex="1" parent="1"><mxGeometry x="60" y="480" width="200" height="100" as="geometry"/></mxCell><mxCell id="proto" value="&lt;b&gt;Prototype/mathkx-designsystemet&lt;/b&gt;&lt;br&gt;React + Vite usability prototype&lt;br&gt;design artefact, not product code;&lt;br&gt;source of the pilot lesson, grammar,&lt;br&gt;and representation ranges" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1fb;strokeColor=#4f7cb0;fontSize=11;fontColor=#2d3748;" vertex="1" parent="1"><mxGeometry x="290" y="480" width="200" height="100" as="geometry"/></mxCell><mxCell id="src" value="&lt;b&gt;src/backend, src/web (planned)&lt;/b&gt;&lt;br&gt;.NET solution and React app&lt;br&gt;created by spec 002&lt;br&gt;(practice flow, F2–F4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7f8a9c;fontSize=11;fontColor=#2d3748;dashed=1;" vertex="1" parent="1"><mxGeometry x="520" y="480" width="200" height="100" as="geometry"/></mxCell><mxCell id="rule" value="Content configures; code computes (ADR 0003, 0004).&lt;br&gt;JSON definition → named generator → deterministic domain implementation. Registries list what code provides; they carry no logic." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#c9b857;fontSize=11;fontColor=#2d3748;" vertex="1" parent="1"><mxGeometry x="60" y="605" width="660" height="60" as="geometry"/></mxCell><mxCell id="gAzure" value="&lt;b&gt;Azure App Service (Linux), region Norway East (ADR 0009)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px&quot;&gt;One deployable: ASP.NET Core host serving the API and the built web app. Learner data stays in region.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#aeb7c4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=13;fontStyle=1;fontColor=#2d3748;" vertex="1" parent="1"><mxGeometry x="780" y="270" width="660" height="440" as="geometry"/></mxCell><mxCell id="web" value="&lt;b&gt;React + TypeScript learner app&lt;/b&gt;&lt;br&gt;Designsystemet + Tailwind (ADR 0007)&lt;br&gt;nb / en, iPad-first, accessible visuals&lt;br&gt;lessons, practice, help-first feedback,&lt;br&gt;honest progress (no mastery %)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f6ec;strokeColor=#3f8a55;fontSize=11;fontColor=#2d3748;" vertex="1" parent="1"><mxGeometry x="800" y="330" width="260" height="110" as="geometry"/></mxCell><mxCell id="api" value="&lt;b&gt;ASP.NET Core thin API (DL-005)&lt;/b&gt;&lt;br&gt;lessons, exercise instances,&lt;br&gt;attempts, progress&lt;br&gt;no mathematics in controllers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f6ec;strokeColor=#3f8a55;fontSize=11;fontColor=#2d3748;" vertex="1" parent="1"><mxGeometry x="1130" y="330" width="290" height="110" as="geometry"/></mxCell><mxCell id="domain" value="&lt;b&gt;C# mathematics domain (DL-005)&lt;/b&gt;&lt;br&gt;generators, validators, representations&lt;br&gt;deterministic: (definition id, version,&lt;br&gt;seed) → instance (ADR 0004)&lt;br&gt;misconception codes, typed outcomes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f6ec;strokeColor=#3f8a55;fontSize=11;fontColor=#2d3748;" vertex="1" parent="1"><mxGeometry x="1130" y="490" width="290" height="110" as="geometry"/></mxCell><mxCell id="packaged" value="&lt;b&gt;Packaged content&lt;/b&gt;&lt;br&gt;lessons, definitions, registries from&lt;br&gt;content/, shipped with the app" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1fb;strokeColor=#4f7cb0;fontSize=11;fontColor=#2d3748;" vertex="1" parent="1"><mxGeometry x="1130" y="630" width="290" height="60" as="geometry"/></mxCell><mxCell id="gLearners" value="&lt;b&gt;Learners&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#aeb7c4;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=13;fontStyle=1;fontColor=#2d3748;" vertex="1" parent="1"><mxGeometry x="780" y="750" width="320" height="110" as="geometry"/></mxCell><mxCell id="learner" value="&lt;b&gt;Learner on iPad or browser&lt;/b&gt;&lt;br&gt;anonymous profile, optional email&lt;br&gt;recovery (ADR 0006); nb or en" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbe9e9;strokeColor=#b5504c;fontSize=11;fontColor=#2d3748;" vertex="1" parent="1"><mxGeometry x="800" y="785" width="280" height="60" as="geometry"/></mxCell><mxCell id="pg" value="&lt;b&gt;Azure Database for PostgreSQL&lt;/b&gt;&lt;br&gt;Flexible Server (ADR 0008)&lt;br&gt;profiles, progress, attempts&lt;br&gt;schema and retention: not yet designed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ece6f7;strokeColor=#6f54a8;fontSize=11;fontColor=#2d3748;" vertex="1" parent="1"><mxGeometry x="1130" y="760" width="290" height="90" as="geometry"/></mxCell><mxCell id="undecided" value="Deliberately undecided (constitution: do not pre-empt):&lt;br&gt;authentication and recovery mechanics, database schema and retention, mastery algorithm,&lt;br&gt;symbolic equivalence, AI use, Exercise Format v1, generator versioning&lt;br&gt;(seed proposal → ADR 0011 after C# fixtures, DL-024), parent/teacher relationships (F9 design proposal)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#c9b857;fontSize=11;fontColor=#2d3748;" vertex="1" parent="1"><mxGeometry x="40" y="750" width="700" height="110" as="geometry"/></mxCell><mxCell id="e1" value="opens" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;fontColor=#374151;labelBackgroundColor=#ffffff;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="contrib" target="pr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="triggers" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;fontColor=#374151;labelBackgroundColor=#ffffff;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="pr" target="ci"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="status" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;fontColor=#374151;labelBackgroundColor=#ffffff;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="ci" target="review"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="on merge to main" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;fontColor=#374151;labelBackgroundColor=#ffffff;exitX=0.500;exitY=0.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;d